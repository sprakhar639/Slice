// use prisma-8

model User {
  id           Int               @id @default(autoincrement())
  email        String            @unique
  username     String            @unique
  name         String
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  memberships  Membership[]
  createdItems WorkItem[]        @relation("WorkItemCreator")
  assignedItems WorkItem[]       @relation("WorkItemAssignee")
  activities   ActivityEvent[]
  comments     Comment[]
}

model Team {
  id        Int               @id @default(autoincrement())
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  memberships Membership[]
  workItems   WorkItem[]
}

model Membership {
  id        Int               @id @default(autoincrement())
  userId    Int
  teamId    Int
  role      String            @default("MEMBER")
  createdAt TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model WorkItem {
  id          Int               @id @default(autoincrement())
  title       String
  description String?
  type        String
  priority    String            @default("MEDIUM")
  status      String            @default("OPEN")
  teamId      Int
  assigneeId  Int?
  createdById Int
  dueDate     TimestamptzString?
  version     Int               @default(1)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  team      Team  @relation(fields: [teamId], references: [id])
  assignee  User? @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  createdBy User  @relation("WorkItemCreator", fields: [createdById], references: [id])

  activities ActivityEvent[]
  comments   Comment[]
}

model ActivityEvent {
  id         Int               @id @default(autoincrement())
  workItemId Int
  actorId    Int
  action     String
  details    Json?
  createdAt  TimestamptzString @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id])
  actor    User     @relation(fields: [actorId], references: [id])
}

model Comment {
  id         Int               @id @default(autoincrement())
  workItemId Int
  authorId   Int
  body       String
  createdAt  TimestamptzString @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
}

model IdempotencyKey {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  userId      Int
  requestHash String
  response    Json?
  createdAt   TimestamptzString @default(now())
}

model OutboxJob {
  id          Int               @id @default(autoincrement())
  type        String
  payload     Json
  status      String            @default("PENDING")
  attempts    Int               @default(0)
  maxAttempts Int               @default(5)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
